# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (FREE - Use local MongoDB or MongoDB Atlas free tier)
MONGODB_URI=mongodb://localhost:27017/youtube-clone
# Or MongoDB Atlas Free: mongodb+srv://username:password@cluster.mongodb.net/youtube-clone

# JWT (FREE - Just a secret string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Google OAuth (FREE - Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary (FREE - 25GB storage, 25GB bandwidth/month)
# Alternative: Use local file storage (see below)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# LOCAL FILE STORAGE (100% FREE - No external service needed)
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./uploads
PUBLIC_URL=http://localhost:5000

# PayPal (FREE SANDBOX - No real money, better than Razorpay!)
# Get credentials from: https://developer.paypal.com/
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# For production, change mode to 'live' and use live credentials

# Email (100% FREE - Gmail with App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=YouTube Clone <noreply@youtubeclone.com>

# SMS/OTP (100% FREE ALTERNATIVES - No Twilio needed!)
# Option 1: Use Email OTP for everyone (recommended)
USE_EMAIL_OTP_ONLY=true

# Option 2: Use free SMS service (limited)
# FREE SMS APIs: textbelt.com (1 free SMS/day), sms77.io (0.25€ free credit)
SMS_PROVIDER=email
# If using textbelt (1 free SMS per day per IP)
TEXTBELT_API_KEY=textbelt

# Translation (100% FREE - No Google Translate API needed!)
# Using free translation libraries
USE_FREE_TRANSLATION=true
# Options: 
# 1. google-translate-api-x (FREE - no API key needed, uses Google Translate web)
# 2. libretranslate (FREE - self-hosted or use public instance)
# 3. mymemory (FREE - 1000 words/day)
TRANSLATION_PROVIDER=google-translate-free

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Session Secret (FREE - Just a random string)
SESSION_SECRET=your_session_secret_key_change_this

# ============================================
# 100% FREE SETUP (No paid services at all)
# ============================================
# 1. MongoDB: Use local MongoDB (free) or MongoDB Atlas free tier (512MB)
# 2. Google OAuth: Free from Google Cloud Console
# 3. File Storage: Use local file system (set USE_LOCAL_STORAGE=true)
# 4. Email: Use Gmail with App Password (free)
# 5. SMS: Use email OTP only (set USE_EMAIL_OTP_ONLY=true)
# 6. Translation: Use google-translate-api-x (free, no API key)
# 7. Payments: Use Razorpay test mode (no real money) or skip payment feature

# OPTIONAL: If you want video hosting
# FREE alternatives to Cloudinary:
# - Local storage (unlimited, uses your disk)
# - Bunny.net (free tier: 10GB storage, 50GB bandwidth)
# - Filebase (free tier: 5GB storage)
